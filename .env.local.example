# ─────────────────────────────────────────────────
# GOOGLE SHEETS (Waitlist Database)
# ─────────────────────────────────────────────────
# 1. Go to console.cloud.google.com
# 2. Create a project → Enable "Google Sheets API"
# 3. Go to IAM → Service Accounts → Create Service Account
# 4. Create a JSON key → download it
# 5. Extract client_email and private_key from the JSON
# 6. Create a Google Sheet → Share it with the client_email (Editor access)
# 7. Copy the Sheet ID from the URL: docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─────────────────────────────────────────────────
# RESEND (Email Newsletter)
# ─────────────────────────────────────────────────
# 1. Sign up at resend.com (free tier: 100 emails/day)
# 2. Get your API key from the dashboard
# 3. Add and verify your domain (optional but recommended)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Ultimate Chicken <hello@ultimatechicken.in>

# ─────────────────────────────────────────────────
# DASHBOARD AUTH (Newsletter Dashboard)
# ─────────────────────────────────────────────────
# Set a strong password for your newsletter dashboard at /dashboard
DASHBOARD_PASSWORD=your_secure_password_here

# ─────────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ultimatechicken.in

# ─────────────────────────────────────────────────
# OUTREACH (Investor/Partner Email Automation)
# ─────────────────────────────────────────────────
# Your BITS Pilani email (used as sender)
BITS_EMAIL=f20XXXXXX@pilani.bits-pilani.ac.in
# If you have 2FA on your Microsoft/BITS account, use an App Password:
# Microsoft Account → Security → Advanced security → App passwords
BITS_EMAIL_PASSWORD=your_password_or_app_password
# Anthropic API key for Claude drafting
ANTHROPIC_API_KEY=sk-ant-...
